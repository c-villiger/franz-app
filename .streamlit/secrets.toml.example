# Vorlage für den gehosteten Betrieb (Streamlit Community Cloud).
#
# Lokal wird diese Datei nicht gebraucht – ohne db_url legt das Dashboard den
# Fortschritt wie bisher in data/vocab.db ab.
#
# In der Streamlit Cloud NICHT als Datei anlegen, sondern den Inhalt unter
#   App → Settings → Secrets
# einfügen. Lokal zum Ausprobieren: als .streamlit/secrets.toml speichern –
# die Datei ist gitignored und darf nie committet werden.

db_url = "libsql://DEINE-DATENBANK-DEINORG.turso.io"
db_token = "hier-das-Token-von-Turso-einsetzen"
